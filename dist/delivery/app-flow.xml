<?xml version="1.0" encoding="UTF-8"?>
<appFlow app="Delivery Food Mock App" entryPage="food">
  <pages>
    <page id="food" screenId="food-screen" title="Food">
      <button id="food-back" label="Back" selector=".food-back" targetPage="delivery-home" action="return to delivery home" />
      <button id="food-location" label="Sunshine Plaza selector" selector=".food-location-copy button" targetPage="food" action="currently visual only" />
      <button id="food-search" label="Search food" selector=".food-search" targetPage="food" action="currently visual only" />
      <button id="food-filter-more" label="More filters" selector=".food-filter-chip--icon" targetPage="food" action="currently visual only" />
      <button id="food-filter-sort" label="Sort By" selector=".food-filter-chip" targetPage="food" action="currently visual only" />
      <button id="food-brand-jollibee" label="Jollibee brand shortcut" selector=".food-brand-card[href='./jollibee.html']" targetPage="jollibee-store" action="open Jollibee store page" />
      <button id="food-brand-dominos" label="Domino's Pizza brand shortcut" selector=".food-brand-card[href='./dominos.html']" targetPage="dominos-store" action="open Domino's Pizza store page" />
      <button id="food-jollibee-card-image" label="Jollibee restaurant image" selector=".food-restaurant-thumb-link[href='./jollibee.html']" targetPage="jollibee-store" action="open Jollibee store page" />
      <button id="food-jollibee-card-title" label="Jollibee restaurant title" selector=".food-restaurant-link[href='./jollibee.html']" targetPage="jollibee-store" action="open Jollibee store page" />
      <button id="food-dominos-card-image" label="Domino's Pizza restaurant image" selector=".food-restaurant-thumb-link[href='./dominos.html']" targetPage="dominos-store" action="open Domino's Pizza store page" />
      <button id="food-dominos-card-title" label="Domino's Pizza restaurant title" selector=".food-restaurant-link[href='./dominos.html']" targetPage="dominos-store" action="open Domino's Pizza store page" />
      <button id="food-other-restaurant-card" label="Other restaurant card" selector=".food-restaurant-thumb-link[href='./food.html']" targetPage="food" action="currently loops on same page placeholder" />
    </page>

    <page id="jollibee-store" screenId="store-screen" title="Jollibee">
      <button id="jollibee-back" label="Back" selector=".food-back" targetPage="food" action="return to food page" />
      <button id="jollibee-group-order" label="Group Order" selector=".store-group-order" targetPage="jollibee-store" action="currently visual only" />
      <button id="jollibee-filter-for-you" label="For You filter" selector=".store-chip--wide" targetPage="jollibee-store" action="currently visual only" />
      <button id="jollibee-filter-vegetarian" label="Vegetarian filter" selector=".store-chip:not(.store-chip--wide):not(.store-chip--icon)" targetPage="jollibee-store" action="currently visual only" />
      <button id="jollibee-search" label="Search icon" selector=".store-chip--icon" targetPage="jollibee-store" action="currently visual only" />
      <button id="jollibee-add-value-two-c" label="Add Value for Two Meal C" selector=".store-item__add[href*='store=jollibee&amp;item=value-two-c']" targetPage="order-summary" action="open order summary for Value for Two Meal C" />
      <button id="jollibee-add-group-meal-b" label="Add Group Meal B" selector=".store-item__add[href*='store=jollibee&amp;item=group-meal-b']" targetPage="order-summary" action="open order summary for Group Meal B" />
      <button id="jollibee-add-chickenjoy-spaghetti" label="Add 2pc Chickenjoy with Jolly Spaghetti Meal" selector=".store-item__add[href*='store=jollibee&amp;item=chickenjoy-spaghetti']" targetPage="order-summary" action="open order summary for 2pc Chickenjoy with Jolly Spaghetti Meal" />
      <button id="jollibee-add-three-piece-meal" label="Add 3pc Chickenjoy Meal" selector=".store-item__add[href*='store=jollibee&amp;item=three-piece-meal']" targetPage="order-summary" action="open order summary for 3pc Chickenjoy Meal" />
      <button id="jollibee-add-two-piece-meal" label="Add 2pc Chickenjoy Meal" selector=".store-item__add[href*='store=jollibee&amp;item=two-piece-meal']" targetPage="order-summary" action="open order summary for 2pc Chickenjoy Meal" />
      <button id="jollibee-add-value-two-a" label="Add Value for Two Meal A" selector=".store-item__add[href*='store=jollibee&amp;item=value-two-a']" targetPage="order-summary" action="open order summary for Value for Two Meal A" />
    </page>

    <page id="dominos-store" screenId="store-screen" title="Domino's Pizza">
      <button id="dominos-back" label="Back" selector=".food-back" targetPage="food" action="return to food page" />
      <button id="dominos-group-order" label="Group Order" selector=".store-group-order" targetPage="dominos-store" action="currently visual only" />
      <button id="dominos-filter-for-you" label="For You filter" selector=".store-chip--wide" targetPage="dominos-store" action="currently visual only" />
      <button id="dominos-filter-vegetarian" label="Vegetarian filter" selector=".store-chip:not(.store-chip--wide):not(.store-chip--icon)" targetPage="dominos-store" action="currently visual only" />
      <button id="dominos-search" label="Search icon" selector=".store-chip--icon" targetPage="dominos-store" action="currently visual only" />
      <button id="dominos-add-large-pizzas" label="Add 1-for-1 Large Pizzas" selector=".store-item__add[href*='store=dominos&amp;item=large-pizzas']" targetPage="order-summary" action="open order summary for 1-for-1 Large Pizzas" />
      <button id="dominos-add-regular-pizzas" label="Add 1-for-1 Regular Pizzas" selector=".store-item__add[href*='store=dominos&amp;item=regular-pizzas']" targetPage="order-summary" action="open order summary for 1-for-1 Regular Pizzas" />
      <button id="dominos-add-family-set" label="Add Family Set" selector=".store-item__add[href*='store=dominos&amp;item=family-set']" targetPage="order-summary" action="open order summary for Family Set" />
      <button id="dominos-add-party-8-10" label="Add Party of 8-10" selector=".store-item__add[href*='store=dominos&amp;item=party-8-10']" targetPage="order-summary" action="open order summary for Party of 8-10" />
      <button id="dominos-add-party-set" label="Add Party Set" selector=".store-item__add[href*='store=dominos&amp;item=party-set']" targetPage="order-summary" action="open order summary for Party Set" />
      <button id="dominos-add-buddies-bundle" label="Add Buddies Bundle" selector=".store-item__add[href*='store=dominos&amp;item=buddies-bundle']" targetPage="order-summary" action="open order summary for Buddies Bundle" />
    </page>

    <page id="order-summary" screenId="order-summary-screen" title="Order Summary" dynamic="true">
      <button id="order-back" label="Back" selector="#orderBackLink" targetPage="previousStorePage" action="return to originating store page" />
      <button id="order-add-items" label="Add Items" selector="#orderAddItemsLink" targetPage="previousStorePage" action="return to originating store page to add more items" />
      <button id="order-edit" label="Edit selected item" selector=".order-edit-link" targetPage="previousStorePage" action="return to originating store page to edit current selection" />
      <button id="order-quantity" label="Quantity pill" selector=".order-qty-pill" targetPage="order-summary" action="currently visual only" />
      <button id="order-recommend-add" label="People also ordered plus button" selector=".order-recommend-card__visual button" targetPage="order-summary" action="currently visual only" dynamicTargetData="recommendationName" />
      <button id="order-place" label="Place order" selector=".order-place-button" targetPage="order-summary" action="currently visual only" />
    </page>
  </pages>

